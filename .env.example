# Токен бота от @BotFather
BOT_TOKEN=
# Ваш Telegram ID (узнать: @userinfobot). Несколько — через запятую
ALLOWED_IDS=
# Качество по умолчанию: hd (720x1280, быстрее) или fhd (1080x1920)
RENDER_QUALITY=hd
# Число параллельных вкладок рендера (6 ГБ — 3, 4 ГБ — 2)
RENDER_WORKERS=3
# Сколько дней хранить ролики на сервере (потом удаляются сами)
RETENTION_DAYS=7
# Если свободного места меньше (ГБ), перед рендером чистим старое агрессивнее
MIN_FREE_GB=3
# Сколько роликов максимум в очереди
MAX_QUEUE=5
# Очистка голоса: off (только срез низов, по умолчанию), light (+ мягкий шумодав), full (шумодав + тембр + компрессия)
VOICE_CLEAN=off

# Озвучка клонированным голосом (ElevenLabs). Если заданы оба значения, в боте появляется кнопка «🤖 Озвучить моим голосом»
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Необязательно: модель и настройки голоса (меньше stability — больше интонации)
# ELEVENLABS_MODEL=eleven_multilingual_v2
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.8
# ELEVENLABS_STYLE=0.2
